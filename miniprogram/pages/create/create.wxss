.wrap {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #475569;
}

.input,
.picker {
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.picker {
  color: #0f172a;
}

.submit {
  margin-top: 8rpx;
}

.error {
  display: block;
  margin-top: 20rpx;
  color: #dc2626;
  font-size: 24rpx;
  text-align: center;
}

.products-card {
  margin-top: 24rpx;
}

.hint {
  display: block;
  font-size: 24rpx;
  color: #2563eb;
  margin-bottom: 16rpx;
}

.muted {
  color: #94a3b8;
  font-size: 26rpx;
}

.product-pick {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.product-pick.selected {
  border-color: #2563eb;
  background: #eff6ff;
}

.product-name {
  flex: 1;
  font-size: 28rpx;
  color: #0f172a;
}

.product-meta {
  font-size: 24rpx;
  color: #64748b;
}

.check {
  width: 40rpx;
  text-align: right;
  color: #2563eb;
  font-weight: bold;
}
