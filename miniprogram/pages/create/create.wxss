.wrap {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #475569;
}

.input,
.picker {
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.picker {
  color: #0f172a;
}

.submit {
  margin-top: 8rpx;
}

.error {
  display: block;
  margin-top: 20rpx;
  color: #dc2626;
  font-size: 24rpx;
  text-align: center;
}
