.page-create {
  padding-bottom: 180rpx;
}

.px {
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.mx {
  margin-left: 32rpx;
  margin-right: 32rpx;
}

.section-head {
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.form-input,
.form-picker {
  background: #f5f6f8;
  border-radius: var(--radius-md);
  padding: 22rpx 24rpx;
  font-size: 28rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.half {
  flex: 1;
}

.center-pad {
  text-align: center;
  padding: 40rpx 0;
}

.product-search-wrap {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.product-search-input {
  flex: 1;
  background: #f5f6f8;
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.product-search-clear {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--color-primary);
  padding: 8rpx 4rpx;
}

.product-search-empty {
  padding-top: 16rpx;
  padding-bottom: 24rpx;
}

.category-scroll {
  width: 100%;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  flex-direction: row;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.category-chip {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: #f5f6f8;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
}

.category-chip.active {
  color: var(--color-primary);
  background: #e8f4fd;
  border-color: rgba(0, 96, 169, 0.25);
  font-weight: 600;
}

.catalog-meta {
  display: block;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.catalog-loading-more {
  padding-top: 8rpx;
  padding-bottom: 16rpx;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -10rpx;
}

.grid-item {
  position: relative;
  width: calc(50% - 20rpx);
  margin: 10rpx;
  padding: 16rpx;
  background: #f5f6f8;
  border-radius: var(--radius-md);
  border: 3rpx solid transparent;
  box-sizing: border-box;
}

.grid-item.selected {
  border-color: var(--color-primary);
  background: #e8f4fd;
}

.grid-img {
  width: 100%;
  height: 160rpx;
  border-radius: var(--radius-sm);
  background: #e8e8e8;
}

.grid-img-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999;
  font-weight: 600;
}

.grid-name {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.grid-price {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  color: var(--color-accent);
  font-weight: 600;
}

.grid-check {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: var(--color-primary);
  color: #fff;
  border-radius: 50%;
  font-size: 22rpx;
  opacity: 0;
}

.grid-item.selected .grid-check {
  opacity: 1;
}

.error {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  color: var(--color-danger);
  font-size: 24rpx;
}
