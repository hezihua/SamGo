<view class="page-create safe-bottom">
  <view class="section-head px">
    <view class="section-head-bar"></view>
    <text class="section-head-title">基本信息</text>
  </view>

  <view class="card mx">
    <view class="form-item">
      <text class="form-label">拼单标题</text>
      <input
        class="form-input"
        placeholder="例如：周六山姆瑞士卷"
        value="{{title}}"
        bindinput="onTitleInput"
      />
      <text class="field-error" wx:if="{{titleError}}">{{titleError}}</text>
    </view>
    <view class="form-item">
      <text class="form-label">取货地址</text>
      <input
        class="form-input"
        placeholder="小区 / 门店 / 约定地点"
        value="{{deliveryAddress}}"
        bindinput="onAddressInput"
      />
      <text class="field-error" wx:if="{{addressError}}">{{addressError}}</text>
    </view>
    <view class="form-row">
      <view class="form-item half">
        <text class="form-label">截止日期</text>
        <picker mode="date" value="{{date}}" start="{{today}}" bindchange="onDateChange">
          <view class="form-picker">{{date || '选择日期'}}</view>
        </picker>
        <text class="field-error" wx:if="{{dateError}}">{{dateError}}</text>
      </view>
      <view class="form-item half">
        <text class="form-label">截止时间</text>
        <picker mode="time" value="{{time}}" bindchange="onTimeChange">
          <view class="form-picker">{{time}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="section-head px">
    <view class="section-head-bar"></view>
    <text class="section-head-title">选择商品</text>
    <text class="section-head-sub" wx:if="{{selectedCount > 0}}">已选 {{selectedCount}}</text>
  </view>

  <view class="card mx">
    <text class="field-error field-error-block" wx:if="{{productError}}">{{productError}}</text>
    <view wx:if="{{productsLoading}}" class="muted center-pad">加载商品…</view>
    <view wx:elif="{{catalogError}}" class="error-text center-pad">{{catalogError}}</view>
    <view wx:elif="{{catalogTotal == 0 && !productSearch && !categoryFilter}}" class="muted center-pad">暂无商品，请先在 Web 后台添加</view>
    <block wx:else>
      <scroll-view scroll-x class="category-scroll" enable-flex show-scrollbar="{{false}}">
        <view class="category-row">
          <view
            class="category-chip {{categoryFilter === '' ? 'active' : ''}}"
            data-cat=""
            bindtap="onCategoryTap"
          >全部</view>
          <view
            wx:for="{{categories}}"
            wx:key="*this"
            class="category-chip {{categoryFilter === item ? 'active' : ''}}"
            data-cat="{{item}}"
            bindtap="onCategoryTap"
          >{{item}}</view>
        </view>
      </scroll-view>
      <view class="product-search-wrap">
        <input
          class="product-search-input"
          type="text"
          placeholder="搜索商品名称或别名"
          value="{{productSearch}}"
          bindinput="onProductSearchInput"
          confirm-type="search"
        />
        <text
          wx:if="{{productSearch}}"
          class="product-search-clear"
          bindtap="onClearProductSearch"
        >清除</text>
      </view>
      <text wx:if="{{catalogTotal > 0}}" class="catalog-meta muted">共 {{catalogTotal}} 件{{hasMore ? '，上拉加载更多' : ''}}</text>
      <view wx:if="{{displayProducts.length == 0 && !productsLoading}}" class="muted center-pad product-search-empty">没有匹配的商品</view>
      <view wx:else class="product-grid">
        <view
          class="grid-item {{item.selected ? 'selected' : ''}}"
          wx:for="{{displayProducts}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onToggleProduct"
        >
          <image
            wx:if="{{item.image_url}}"
            class="grid-img"
            src="{{item.image_url}}"
            mode="aspectFill"
            lazy-load
          />
          <view wx:else class="grid-img grid-img-ph">Sam</view>
          <text class="grid-name">{{item.name}}</text>
          <text class="grid-price">¥{{item.price}}</text>
          <view class="grid-check">{{item.selected ? '✓' : ''}}</view>
        </view>
      </view>
      <view wx:if="{{catalogLoadingMore}}" class="muted center-pad catalog-loading-more">加载中…</view>
    </block>
  </view>

  <view class="bottom-bar">
    <text class="submit-error" wx:if="{{submitError}}">{{submitError}}</text>
    <view
      class="btn-primary bottom-bar-btn {{loading ? 'is-disabled' : ''}}"
      bindtap="onSubmit"
    >
      {{loading ? '发布中…' : '发布拼单'}}
    </view>
  </view>
</view>
