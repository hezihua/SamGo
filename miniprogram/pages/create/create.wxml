<view class="wrap">
  <view class="card">
    <text class="label">拼单标题</text>
    <input
      class="input"
      placeholder="例如：周六山姆瑞士卷"
      value="{{title}}"
      bindinput="onTitleInput"
    />

    <text class="label">取货地址</text>
    <input
      class="input"
      placeholder="小区/门店/约定地点"
      value="{{deliveryAddress}}"
      bindinput="onAddressInput"
    />

    <text class="label">截止日期</text>
    <picker mode="date" value="{{date}}" start="{{today}}" bindchange="onDateChange">
      <view class="picker">{{date || '请选择日期'}}</view>
    </picker>

    <text class="label">截止时间</text>
    <picker mode="time" value="{{time}}" bindchange="onTimeChange">
      <view class="picker">{{time}}</view>
    </picker>

    <text class="label">最少人数</text>
    <input
      class="input"
      type="number"
      value="{{minParticipants}}"
      bindinput="onMinInput"
    />
  </view>

  <view class="card products-card">
    <text class="label">拼单商品（后台商品库，至少选 1 个）</text>
    <text class="hint" wx:if="{{selectedCount > 0}}">已选 {{selectedCount}} 项</text>
    <view wx:if="{{productsLoading}}" class="muted">加载商品…</view>
    <view wx:elif="{{products.length == 0}}" class="muted">暂无商品，请先在 Web 后台添加</view>
    <block wx:else>
      <view
        class="product-pick {{item.selected ? 'selected' : ''}}"
        wx:for="{{products}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onToggleProduct"
      >
        <text class="product-name">{{item.name}}</text>
        <text class="product-meta">¥{{item.price}} · {{item.category}}</text>
        <text class="check">{{item.selected ? '✓' : ''}}</text>
      </view>
    </block>
  </view>

  <button
    class="btn-primary submit"
    loading="{{loading}}"
    disabled="{{loading}}"
    bindtap="onSubmit"
  >
    发布拼单
  </button>
  <text class="error" wx:if="{{error}}">{{error}}</text>
</view>
