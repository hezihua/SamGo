.page-detail {
  padding-bottom: 48rpx;
  background: var(--color-bg);
}

.px {
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.mx {
  margin-left: 32rpx;
  margin-right: 32rpx;
}

.state-box {
  padding: 120rpx 32rpx;
  text-align: center;
}

.error-text {
  color: var(--color-danger);
}

.detail-hero {
  background: linear-gradient(165deg, #0088dd 0%, #0060a9 55%, #004a85 100%);
  padding: 28rpx 32rpx 72rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-title {
  flex: 1;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.35;
}

.hero-status {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  background: rgba(255, 255, 255, 0.95);
  color: var(--color-primary);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-chips {
  margin-top: 32rpx;
}

.chip {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.45;
}

.chip-k {
  width: 80rpx;
  flex-shrink: 0;
  color: rgba(255, 255, 255, 0.6);
}

.chip-v {
  flex: 1;
  color: rgba(255, 255, 255, 0.98);
}

.action-float {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  margin-top: -48rpx;
  padding: 32rpx 28rpx 24rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.action-btn {
  width: 100% !important;
  height: 92rpx;
  padding: 0 !important;
  overflow: hidden;
}

.action-btn .btn-label {
  line-height: 92rpx;
}

.action-hint {
  display: block;
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-muted);
  line-height: 1.55;
}

.action-footer {
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--color-border);
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-link {
  font-size: 28rpx;
  color: var(--color-primary);
}

.action-close {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.section-head {
  margin-bottom: 16rpx;
}

.section-first {
  margin-top: 36rpx;
}

.product-list {
  padding-bottom: 8rpx;
}

.sku-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 24rpx 20rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-card);
}

.sku-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  background: #f0f0f0;
}

.sku-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #aaa;
  font-size: 22rpx;
  font-weight: 600;
}

.sku-body {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.sku-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
}

.sku-price {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  color: var(--color-accent);
  font-weight: 700;
}

.qty-stepper {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx;
  background: var(--color-bg);
  border-radius: 999rpx;
}

.qty-stepper-sm {
  padding: 2rpx;
}

.qty-stepper-add-only {
  padding-left: 8rpx;
}

.qty-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 1rpx var(--color-border);
}

.qty-stepper-sm .qty-btn {
  width: 48rpx;
  height: 48rpx;
}

.qty-btn-plus {
  background: var(--color-primary);
  box-shadow: none;
}

.qty-btn-plus .qty-btn-text {
  color: #fff;
}

.qty-btn.is-disabled {
  opacity: 0.35;
}

.qty-btn-text {
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1;
  color: var(--color-text);
}

.qty-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.qty-stepper-sm .qty-num {
  min-width: 40rpx;
  font-size: 26rpx;
}

.sku-qty-readonly {
  flex-shrink: 0;
  min-width: 120rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.empty-inline {
  padding: 28rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.card.mx {
  padding: 8rpx 28rpx;
}

.cart-line {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.cart-line:last-child {
  border-bottom: none;
}

.cart-info {
  flex: 1;
  min-width: 0;
}

.cart-name {
  display: block;
  font-size: 28rpx;
}

.cart-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.cart-actions {
  display: flex;
  flex-shrink: 0;
  gap: 20rpx;
  margin-left: 16rpx;
}

.link-btn {
  font-size: 26rpx;
  color: var(--color-primary);
}

.link-btn.danger {
  color: var(--color-danger);
}

.team-block {
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--color-border);
}

.team-block:last-child {
  margin-bottom: 0;
  padding-bottom: 0;
  border-bottom: none;
}

.team-head {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.team-avatar {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: #e8f4fd;
  color: var(--color-primary);
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 12rpx;
}

.team-name {
  font-weight: 600;
  font-size: 28rpx;
}

.team-line {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0 8rpx 60rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.team-qty {
  color: var(--color-text);
  font-weight: 500;
}
