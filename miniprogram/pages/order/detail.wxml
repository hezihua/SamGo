<view class="page-detail safe-bottom">
  <view wx:if="{{loading}}" class="state-box">
    <text class="muted">加载中…</text>
  </view>
  <view wx:elif="{{error}}" class="state-box">
    <text class="error-text">{{error}}</text>
  </view>
  <block wx:else>
    <view class="detail-hero">
      <view class="hero-top">
        <text class="hero-title">{{order.title}}</text>
        <text class="hero-status">{{statusLabel}}</text>
      </view>
      <view class="hero-chips">
        <view class="chip">
          <text class="chip-k">截止</text>
          <text class="chip-v">{{order.deadlineShort}}</text>
        </view>
        <view class="chip">
          <text class="chip-k">取货</text>
          <text class="chip-v">{{order.delivery_address}}</text>
        </view>
      </view>
    </view>

    <view class="action-float mx">
      <button class="btn-primary action-btn" open-type="share">
        <text class="btn-label">分享拼单到群</text>
      </button>
      <text class="action-hint">好友点开小程序卡片即可进入本页加购</text>
      <view class="action-footer">
        <text class="action-link" bindtap="onShowWxacode">生成拼单小程序码</text>
        <text class="action-link" bindtap="onCopySummary">复制汇总文案（截止后对账用）</text>
        <text wx:if="{{canClose}}" class="action-close" bindtap="onCloseOrder">截止拼单</text>
      </view>
    </view>

    <view class="section-head px section-first">
      <view class="section-head-bar"></view>
      <text class="section-head-title">选购商品</text>
    </view>
    <view class="product-list px">
      <view class="sku-card" wx:for="{{products}}" wx:key="id">
        <image
          wx:if="{{item.image_url}}"
          class="sku-img"
          src="{{item.image_url}}"
          mode="aspectFill"
        />
        <view wx:else class="sku-img sku-ph">Sam</view>
        <view class="sku-body">
          <text class="sku-name">{{item.name}}</text>
          <text class="sku-price">¥{{item.price}}</text>
        </view>
        <view wx:if="{{canAdd}}" class="qty-stepper {{canMinus ? '' : 'qty-stepper-add-only'}}">
          <view
            wx:if="{{canMinus}}"
            class="qty-btn {{item.myQty < 1 ? 'is-disabled' : ''}}"
            data-product-id="{{item.id}}"
            data-item-id="{{item.myItemId}}"
            data-qty="{{item.myQty}}"
            bindtap="onQtyMinus"
          >
            <text class="qty-btn-text">−</text>
          </view>
          <text wx:if="{{item.myQty > 0 || canMinus}}" class="qty-num">{{item.myQty}}</text>
          <view
            class="qty-btn qty-btn-plus"
            data-product-id="{{item.id}}"
            data-item-id="{{item.myItemId}}"
            data-qty="{{item.myQty}}"
            bindtap="onQtyPlus"
          >
            <text class="qty-btn-text">+</text>
          </view>
        </view>
        <view wx:else class="sku-qty-readonly">
          <text wx:if="{{item.myQty > 0}}">已选 {{item.myQty}}</text>
          <text wx:else class="muted">已截止</text>
        </view>
      </view>
    </view>

    <view class="section-head px">
      <view class="section-head-bar"></view>
      <text class="section-head-title">我的选购</text>
    </view>
    <view class="card mx">
      <view wx:if="{{myItems.length === 0}}" class="empty-inline">还没有加购</view>
      <view class="cart-line" wx:for="{{myItems}}" wx:key="id">
        <view class="cart-info">
          <text class="cart-name">{{item.product_name}}</text>
          <text class="cart-sub">x{{item.quantity}} · ¥{{item.product_price}}</text>
        </view>
        <view wx:if="{{canAdd}}" class="qty-stepper qty-stepper-sm {{canMinus ? '' : 'qty-stepper-add-only'}}">
          <view
            wx:if="{{canMinus}}"
            class="qty-btn {{item.quantity < 1 ? 'is-disabled' : ''}}"
            data-item-id="{{item.id}}"
            data-qty="{{item.quantity}}"
            bindtap="onQtyMinus"
          >
            <text class="qty-btn-text">−</text>
          </view>
          <text class="qty-num">{{item.quantity}}</text>
          <view
            class="qty-btn qty-btn-plus"
            data-item-id="{{item.id}}"
            data-qty="{{item.quantity}}"
            bindtap="onQtyPlus"
          >
            <text class="qty-btn-text">+</text>
          </view>
        </view>
      </view>
    </view>

    <view class="section-head px">
      <view class="section-head-bar"></view>
      <text class="section-head-title">全团按商品汇总</text>
    </view>
    <view class="card mx">
      <view wx:if="{{productTotals.length === 0}}" class="empty-inline">暂无加购</view>
      <view class="agg-line" wx:for="{{productTotals}}" wx:key="product_name">
        <view class="agg-info">
          <text class="agg-name">{{item.product_name}}</text>
          <text class="agg-sub">¥{{item.unit_price}} / 件</text>
        </view>
        <text class="agg-qty">共 {{item.quantity}} 件</text>
        <text class="agg-amt">¥{{item.amountText}}</text>
      </view>
      <view wx:if="{{productTotals.length > 0}}" class="agg-total">
        <text>合计</text>
        <text class="agg-total-amt">¥{{totalAmount}}</text>
      </view>
    </view>

    <view class="section-head px">
      <view class="section-head-bar"></view>
      <text class="section-head-title">全团选购（按人）</text>
    </view>
    <view class="card mx">
      <view wx:if="{{teamGroups.length === 0}}" class="empty-inline">暂无成员加购</view>
      <view class="team-block" wx:for="{{teamGroups}}" wx:for-index="gidx" wx:key="gidx">
        <view class="team-head">
          <view class="team-avatar">{{item.avatarLetter}}</view>
          <text class="team-name">{{item.nickname}}</text>
        </view>
        <view class="team-line" wx:for="{{item.items}}" wx:for-item="line" wx:key="id">
          <text>{{line.product_name}}</text>
          <text class="team-qty">x{{line.quantity}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{wxacodeVisible}}" class="wxacode-mask" bindtap="onCloseWxacode">
    <view class="wxacode-panel" catchtap="">
      <text class="wxacode-title">扫码进入本拼单</text>
      <view wx:if="{{wxacodeLoading}}" class="wxacode-loading muted">生成中…</view>
      <image
        wx:else
        class="wxacode-img"
        src="{{wxacodeSrc}}"
        mode="aspectFit"
        show-menu-by-longpress
      />
      <text class="wxacode-hint">可保存发群，长按图片也可识别</text>
      <view wx:if="{{wxacodeSrc}}" class="wxacode-actions">
        <view class="btn-primary wxacode-save" bindtap="onSaveWxacode">保存到相册</view>
      </view>
      <text class="wxacode-close" bindtap="onCloseWxacode">关闭</text>
    </view>
  </view>
</view>
