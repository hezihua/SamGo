<view class="wrap">
  <view wx:if="{{loading}}" class="muted center">加载中…</view>
  <view wx:elif="{{error}}" class="error">{{error}}</view>
  <block wx:else>
    <view class="card">
      <text class="title">{{order.title}}</text>
      <text class="muted">截止 {{order.deadline}}</text>
      <text class="muted">取货 {{order.delivery_address}}</text>
      <text class="tag">{{statusLabel}}</text>
    </view>

    <view class="action-row">
      <button
        wx:if="{{canClose}}"
        size="mini"
        class="btn-warn"
        bindtap="onCloseOrder"
      >
        截止拼单
      </button>
      <button size="mini" class="btn-secondary" bindtap="onCopySummary">
        复制汇总发群
      </button>
    </view>

    <view class="card">
      <text class="section-title">选购商品</text>
      <view class="product-row" wx:for="{{products}}" wx:key="id">
        <image
          wx:if="{{item.image_url}}"
          class="product-thumb"
          src="{{item.image_url}}"
          mode="aspectFill"
        />
        <view wx:else class="product-thumb placeholder">图</view>
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-price">¥{{item.price}}</text>
        </view>
        <button
          size="mini"
          class="btn-primary"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="onAddProduct"
          disabled="{{!canAdd}}"
        >
          加入
        </button>
      </view>
    </view>

    <view class="card">
      <text class="section-title">我的选购</text>
      <view wx:if="{{myItems.length === 0}}" class="muted">暂无</view>
      <view class="item-row my-row" wx:for="{{myItems}}" wx:key="id">
        <text class="item-text"
          >{{item.product_name}} x{{item.quantity}}（¥{{item.product_price}}）</text
        >
        <view wx:if="{{canAdd}}" class="item-actions">
          <button
            size="mini"
            class="btn-secondary"
            data-id="{{item.id}}"
            data-name="{{item.product_name}}"
            data-qty="{{item.quantity}}"
            bindtap="onEditMyItem"
          >
            改数量
          </button>
          <button
            size="mini"
            class="btn-warn"
            data-id="{{item.id}}"
            bindtap="onDeleteMyItem"
          >
            删除
          </button>
        </view>
      </view>
    </view>

    <view class="card">
      <text class="section-title">全团选购</text>
      <view wx:if="{{teamGroups.length === 0}}" class="muted">暂无</view>
      <view
        class="team-block"
        wx:for="{{teamGroups}}"
        wx:for-index="gidx"
        wx:key="gidx"
      >
        <text class="team-name">{{item.nickname}}</text>
        <view class="item-row" wx:for="{{item.items}}" wx:for-item="line" wx:key="id">
          {{line.product_name}} x{{line.quantity}}（¥{{line.product_price}}）
        </view>
      </view>
    </view>

    <button class="btn-primary share" open-type="share">分享给好友</button>
  </block>
</view>
