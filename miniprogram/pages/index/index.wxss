.wrap {
  padding: 32rpx;
  padding-bottom: 120rpx;
}

.center {
  text-align: center;
  padding: 40rpx;
}

.order-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.tag {
  display: inline-block;
  margin-top: 16rpx;
  padding: 6rpx 16rpx;
