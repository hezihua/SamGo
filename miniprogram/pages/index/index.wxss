.page-home {
  min-height: 100vh;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.px {
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.home-header {
  background: linear-gradient(180deg, #0060a9 0%, #0077c8 100%);
  padding: 24rpx 32rpx 48rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.user-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.5);
}

.user-meta {
  margin-left: 24rpx;
}

.user-greet {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.user-tip {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.tabs {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
  margin-bottom: 8rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--color-text-muted);
  background: #fff;
  border-radius: 999rpx;
  box-shadow: var(--shadow-card);
}

.tab-on {
  color: #fff;
  background: var(--color-primary);
  font-weight: 600;
}

.section-head {
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}

.state-box,
.empty-box {
  padding: 80rpx 32rpx;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: #e8f4fd;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text);
}

.empty-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.error-text {
  color: var(--color-danger);
  font-size: 28rpx;
}

.order-list {
  padding-bottom: 24rpx;
}

.order-card {
  position: relative;
  background: #fff;
  border-radius: var(--radius-lg);
  padding: 28rpx 56rpx 28rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.order-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.order-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.order-meta-row {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
}

.meta-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  opacity: 0.7;
}

.meta-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.order-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

.footer-link {
  text-align: center;
  padding: 24rpx 0 48rpx;
}

.logout-link {
  font-size: 26rpx;
  color: var(--color-text-muted);
}
