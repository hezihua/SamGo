<view class="page-home safe-bottom">
  <view class="home-header">
    <view class="user-row">
      <view class="avatar">{{userInitial}}</view>
      <view class="user-meta">
        <text class="user-greet">你好，{{user.nickname || '拼友'}}</text>
        <text class="user-tip">看看群里进行中的拼单</text>
      </view>
    </view>
  </view>

  <view class="tabs px">
    <text
      class="tab {{listTab === 'active' ? 'tab-on' : ''}}"
      data-tab="active"
      bindtap="onTabChange"
      >进行中</text
    >
    <text
      class="tab {{listTab === 'history' ? 'tab-on' : ''}}"
      data-tab="history"
      bindtap="onTabChange"
      >历史拼单</text
    >
  </view>

  <view class="section-head px">
    <view class="section-head-bar"></view>
    <text class="section-head-title">{{listTab === 'history' ? '已截止' : '进行中'}}</text>
    <text class="section-head-sub" wx:if="{{!loading && orders.length > 0}}"
      >{{orders.length}} 个</text
    >
  </view>

  <view wx:if="{{loading}}" class="state-box">
    <text class="muted">加载中…</text>
  </view>
  <view wx:elif="{{error}}" class="state-box">
    <text class="error-text">{{error}}</text>
  </view>
  <view wx:elif="{{orders.length === 0}}" class="empty-box">
    <view class="empty-icon"></view>
    <text class="empty-title">{{listTab === 'history' ? '暂无历史拼单' : '还没有进行中的拼单'}}</text>
    <text class="empty-desc">{{listTab === 'history' ? '参与或发起并已截止的拼单会出现在这里' : '发起一个，分享到微信群让大家选购'}}</text>
  </view>
  <view wx:else class="order-list px">
    <view
      class="order-card"
      wx:for="{{orders}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onOrderTap"
    >
      <view class="order-card-top">
        <text class="order-title">{{item.title}}</text>
        <text class="tag {{item.status === 'open' || item.status === 'closing' ? 'tag-open' : 'tag-closed'}}">{{item.statusLabel}}</text>
      </view>
      <view class="order-meta-row">
        <text class="meta-icon">⏱</text>
        <text class="meta-text">{{item.deadlineShort}}</text>
      </view>
      <view class="order-meta-row">
        <text class="meta-icon">📍</text>
        <text class="meta-text">{{item.delivery_address}}</text>
      </view>
      <text class="order-arrow">›</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="btn-primary bottom-bar-btn" bindtap="onCreate">发起拼单</view>
  </view>

  <view class="footer-link px">
    <text class="logout-link" bindtap="onLogout">退出登录</text>
  </view>
</view>
