.wrap {
  padding: 48rpx 32rpx;
}

.hero {
  text-align: center;
  margin-bottom: 32rpx;
}

.hero .title {
  display: block;
  margin-bottom: 12rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #475569;
}

.input {
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 28rpx;
}

.login-btn {
  margin-top: 8rpx;
}

.error {
  display: block;
  margin-top: 20rpx;
  color: #dc2626;
  font-size: 24rpx;
}
