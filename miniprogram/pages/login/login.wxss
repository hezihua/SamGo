.wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  box-sizing: border-box;
}

.card.hero {
  flex-shrink: 0;
  background: linear-gradient(160deg, #0080d4 0%, #0060a9 45%, #004a85 100%);
  border-radius: 0 0 48rpx 48rpx;
  padding: 32rpx 48rpx calc(72rpx + env(safe-area-inset-top));
  text-align: center;
  margin-bottom: 0;
  box-shadow: none;
}

.card.hero .title {
  display: block;
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.card.hero .muted {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.wrap > .card:not(.hero) {
  flex: 1;
  margin: -36rpx 32rpx 0;
  padding: 40rpx 36rpx 48rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.label {
  display: block;
  width: 100%;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f6f8;
  border-radius: var(--radius-md);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

button.btn-primary.login-btn {
  width: 100% !important;
  max-width: 560rpx;
  margin-top: 48rpx !important;
  margin-left: auto !important;
  margin-right: auto !important;
  height: 96rpx;
  line-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-success);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  border: none;
}

button.btn-primary.login-btn::after {
  border: none;
}

.error {
  display: block;
  width: 100%;
  margin-top: 24rpx;
  text-align: center;
  color: var(--color-danger);
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-word;
}
