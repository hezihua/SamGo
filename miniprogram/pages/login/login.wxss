.page-login,
.wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
  box-sizing: border-box;
}

.login-hero,
.card.hero {
  flex-shrink: 0;
  background: linear-gradient(160deg, #0080d4 0%, #0060a9 45%, #004a85 100%);
  border-radius: 0 0 48rpx 48rpx;
  padding: 32rpx 48rpx calc(72rpx + env(safe-area-inset-top));
  text-align: center;
  margin-bottom: 0;
  box-shadow: none;
}

.login-title,
.card.hero .title {
  display: block;
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.login-sub,
.card.hero .muted {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.login-panel,
.wrap > .card:not(.hero) {
  flex: 1;
  margin: -36rpx 32rpx 0;
  padding: 40rpx 36rpx 48rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.field-label,
.label {
  display: block;
  width: 100%;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.field-input,
.input {
  width: 100%;
  box-sizing: border-box;
  display: block;
  height: 88rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  background: #f5f6f8;
  border-radius: var(--radius-md);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.input-ph {
  color: var(--color-text-muted);
  font-size: 28rpx;
}

.network-warn {
  display: block;
  width: 100%;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  background: #fff7e6;
  color: #ad6800;
  font-size: 24rpx;
  line-height: 1.5;
  border-radius: var(--radius-md);
}

.wrap > .card:not(.hero) > .login-btn,
.wrap > .card:not(.hero) > button.login-btn {
  width: 100% !important;
  max-width: 560rpx;
  margin-top: 48rpx !important;
  margin-left: auto !important;
  margin-right: auto !important;
}

.login-btn-wrap {
  width: 100%;
  margin-top: 48rpx;
  display: flex;
  justify-content: center;
}

.login-btn-wrap .login-btn,
.login-btn,
button.btn-wechat.login-btn,
button.btn-primary.login-btn {
  margin: 0 !important;
  width: 100% !important;
  max-width: 560rpx;
  height: 96rpx;
  line-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.error {
  display: block;
  width: 100%;
  margin-top: 24rpx;
  text-align: center;
  color: var(--color-danger);
  font-size: 24rpx;
  line-height: 1.5;
  word-break: break-word;
}

.api-hint {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
}
