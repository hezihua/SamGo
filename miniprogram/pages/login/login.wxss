/* 兼容现有 login.wxml 结构，套用新视觉 */
.page-login,
.wrap {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.brand-bg,
.card.hero {
  flex: 0 0 380rpx;
  background: linear-gradient(160deg, #0080d4 0%, #0060a9 45%, #004a85 100%);
  border-radius: 0 0 48rpx 48rpx;
  padding: 48rpx 48rpx 72rpx;
  text-align: center;
  margin-bottom: 0;
  box-shadow: none;
}

.brand-inner {
  padding-top: 32rpx;
}

.logo-badge {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  margin: 0 auto;
  background: rgba(255, 255, 255, 0.95);
  color: var(--color-primary);
  font-size: 56rpx;
  font-weight: 700;
  border-radius: 32rpx;
}

.brand-name,
.hero .title {
  display: block;
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
}

.brand-slogan,
.hero .muted {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
}

.login-sheet,
.wrap > .card:not(.hero) {
  margin: -40rpx 32rpx 0;
  padding: 40rpx 36rpx 48rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.sheet-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.field-label,
.label {
  display: block;
  margin-top: 32rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.field-input,
.input {
  background: #f5f6f8;
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  font-size: 28rpx;
}

.login-btn {
  margin-top: 40rpx;
  height: 96rpx;
  line-height: 96rpx;
}

.btn-wechat.login-btn,
.btn-primary.login-btn {
  background: var(--color-success);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  border: none;
}

.btn-wechat.login-btn::after,
.btn-primary.login-btn::after {
  border: none;
}

.error {
  display: block;
  margin-top: 24rpx;
  text-align: center;
  color: var(--color-danger);
  font-size: 24rpx;
}
