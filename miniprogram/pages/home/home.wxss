.page-home {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.mx {
  margin-left: 32rpx;
  margin-right: 32rpx;
}

.hero {
  padding: 48rpx 32rpx 56rpx;
  background: linear-gradient(160deg, #0080d4 0%, #0060a9 100%);
  border-radius: 0 0 40rpx 40rpx;
  text-align: center;
}

.hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.hero-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.75);
}

.user-bar {
  display: flex;
  align-items: center;
  margin-top: -28rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.avatar {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #e0f2fe;
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 50%;
}

.user-name {
  flex: 1;
  margin-left: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.logout {
  font-size: 26rpx;
  color: var(--color-text-muted);
  padding: 8rpx 0 8rpx 16rpx;
}

.menu {
  margin-top: 32rpx;
}

.menu-item {
  position: relative;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
}

.menu-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.menu-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
  padding-right: 48rpx;
}

.menu-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: #ccc;
  font-weight: 300;
}

.login-card {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 36rpx 48rpx;
}

.login-input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f6f8;
  border-radius: var(--radius-md);
  padding: 0 28rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

button.btn-primary.login-btn {
  width: 100% !important;
  max-width: 560rpx;
  margin-top: 40rpx !important;
  margin-left: auto !important;
  margin-right: auto !important;
  height: 96rpx;
  line-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  border: none;
}

button.btn-primary.login-btn::after {
  border: none;
}

.login-error {
  display: block;
  width: 100%;
  margin-top: 20rpx;
  text-align: center;
  color: var(--color-danger);
  font-size: 24rpx;
}
