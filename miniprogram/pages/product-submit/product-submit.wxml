<view class="page-submit safe-bottom">
  <view wx:if="{{resubmitId}}" class="resubmit-banner mx">
    <text>正在修改未通过的商品，改好后点下方提交</text>
    <text class="resubmit-cancel" bindtap="onCancelResubmit">取消</text>
  </view>

  <view class="card mx form-card form-card-top">
    <view class="form-item">
      <text class="form-label">名称</text>
      <input class="form-input" placeholder="例如：瑞士卷" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-row">
      <view class="form-item half">
        <text class="form-label">价格（元）</text>
        <input class="form-input" type="digit" placeholder="0.00" value="{{price}}" bindinput="onPriceInput" />
      </view>
      <view class="form-item half">
        <text class="form-label">单位</text>
        <input class="form-input" value="{{unit}}" bindinput="onUnitInput" />
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">分类</text>
      <input class="form-input" value="{{category}}" bindinput="onCategoryInput" />
    </view>
    <view class="form-item">
      <text class="form-label">描述</text>
      <textarea class="form-textarea" value="{{description}}" bindinput="onDescInput" />
    </view>
    <view class="form-item form-item-last">
      <text class="form-label">图片<text class="req">*</text></text>
      <button class="image-upload-btn" plain hover-class="image-upload-hover" bindtap="onChooseImage">
        <view class="image-upload {{imageUrl ? 'image-upload-has' : ''}}">
          <image wx:if="{{imageUrl}}" class="thumb" src="{{imageUrl}}" mode="aspectFill" />
          <view wx:else class="image-placeholder">
            <text class="image-plus">+</text>
            <text class="image-hint">选择图片</text>
          </view>
          <text wx:if="{{imageUrl}}" class="image-change">更换</text>
        </view>
      </button>
      <text wx:if="{{pickStatus}}" class="pick-status">{{pickStatus}}</text>
    </view>
  </view>

  <view wx:if="{{rejectedList.length > 0}}" class="section-head px pending-head">
    <view class="section-head-bar section-head-bar-danger"></view>
    <text class="section-head-title">审核未通过</text>
  </view>
  <view wx:if="{{rejectedList.length > 0}}" class="card mx pending-card">
    <view class="pending-row" wx:for="{{rejectedList}}" wx:key="id">
      <view class="pending-main">
        <text class="pending-name">{{item.name}}</text>
        <text wx:if="{{item.review_note}}" class="pending-reject-note">{{item.review_note}}</text>
        <text wx:else class="pending-reject-note muted">管理员未填写原因，请修改后重新提交</text>
      </view>
      <text
        class="pending-action"
        data-id="{{item.id}}"
        bindtap="onEditRejected"
      >修改</text>
    </view>
  </view>

  <view wx:if="{{pendingList.length > 0}}" class="section-head px pending-head">
    <view class="section-head-bar"></view>
    <text class="section-head-title">待审核</text>
  </view>
  <view wx:if="{{pendingList.length > 0}}" class="card mx pending-card">
    <view class="pending-row" wx:for="{{pendingList}}" wx:key="id">
      <view class="pending-main">
        <text class="pending-name">{{item.name}}</text>
        <text class="pending-meta">等待管理员审核</text>
      </view>
      <text class="pending-tag">审核中</text>
    </view>
  </view>

  <view class="bottom-bar">
    <view class="btn-primary bottom-bar-btn {{submitting ? 'is-disabled' : ''}}" bindtap="onSubmit">
      {{submitting ? '提交中…' : (resubmitId ? '重新提交审核' : '提交审核')}}
    </view>
  </view>
</view>
