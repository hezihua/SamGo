<view class="page-submit safe-bottom">
  <view class="card mx form-card form-card-top">
    <view class="form-item">
      <text class="form-label">名称</text>
      <input class="form-input" placeholder="例如：瑞士卷" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-row">
      <view class="form-item half">
        <text class="form-label">价格（元）</text>
        <input class="form-input" type="digit" placeholder="0.00" value="{{price}}" bindinput="onPriceInput" />
      </view>
      <view class="form-item half">
        <text class="form-label">单位</text>
        <input class="form-input" value="{{unit}}" bindinput="onUnitInput" />
      </view>
    </view>
    <view class="form-item">
      <text class="form-label">分类</text>
      <input class="form-input" value="{{category}}" bindinput="onCategoryInput" />
    </view>
    <view class="form-item">
      <text class="form-label">描述</text>
      <textarea class="form-textarea" value="{{description}}" bindinput="onDescInput" />
    </view>
    <view class="form-item form-item-last">
      <text class="form-label">图片（选填）</text>
      <view class="image-upload" bindtap="onChooseImage">
        <image wx:if="{{imageUrl}}" class="thumb" src="{{imageUrl}}" mode="aspectFill" />
        <view wx:else class="image-placeholder">
          <text class="image-plus">+</text>
          <text class="image-hint">选择图片</text>
        </view>
        <text wx:if="{{imageUrl}}" class="image-change">更换</text>
      </view>
    </view>
  </view>
  <view class="pending-mini mx" wx:if="{{pending.length > 0}}">
    <text class="pending-mini-label">待审核 {{pending.length}} 条</text>
  </view>
  <view class="bottom-bar">
    <view class="btn-primary bottom-bar-btn {{submitting ? 'is-disabled' : ''}}" bindtap="onSubmit">{{submitting ? '提交中…' : '提交审核'}}</view>
  </view>
</view>
