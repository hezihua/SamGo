@import "../create/create.wxss";

.page-submit {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
  padding-top: 24rpx;
}

.form-card-top {
  margin-top: 0;
}

.req {
  color: var(--color-danger);
  margin-left: 4rpx;
}

.pending-mini {
  margin-top: 16rpx;
  text-align: center;
}

.pending-mini-label {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.intro {
  margin-top: 16rpx;
  margin-bottom: 8rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, #e8f4fc 0%, #f0f7ff 100%);
  border-radius: var(--radius-lg);
  border: 1rpx solid rgba(0, 96, 169, 0.12);
}

.intro-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-primary-dark);
  margin-bottom: 12rpx;
}

.intro-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.form-card {
  margin-top: 8rpx;
}

.req {
  color: var(--color-danger);
  margin-left: 4rpx;
}

.input-ph {
  color: #b0b8c4;
  font-size: 28rpx;
}

.form-item-last {
  margin-bottom: 0;
}

.form-textarea {
  background: #f5f6f8;
  border-radius: var(--radius-md);
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  min-height: 168rpx;
  line-height: 1.5;
}

.image-upload-btn {
  margin: 0;
  padding: 0;
  border: none;
  background: transparent;
  line-height: normal;
  width: 200rpx;
  height: 200rpx;
}

.image-upload-btn::after {
  border: none;
}

.pick-status {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  line-height: 1.4;
  word-break: break-all;
}

.image-upload {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  background: #f5f6f8;
  border: 2rpx dashed #cbd5e1;
  box-sizing: border-box;
}

.image-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.image-plus {
  font-size: 48rpx;
  font-weight: 300;
  color: var(--color-primary);
  line-height: 1;
}

.image-hint {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.thumb {
  width: 100%;
  height: 100%;
  display: block;
}

.image-change {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  padding: 8rpx 0;
}

.notice {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
}

.notice-dot {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
  background: #e0f2fe;
  border-radius: 50%;
}

.notice-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.55;
}

.pending-head {
  margin-top: 32rpx;
}

.pending-card {
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.pending-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.pending-row:last-child {
  border-bottom: none;
}

.pending-main {
  flex: 1;
  min-width: 0;
}

.pending-name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pending-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-primary);
}

.pending-tag {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #b45309;
  background: #fef3c7;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.section-head-bar-danger {
  background: var(--color-danger, #dc2626);
}

.pending-reject-note {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-danger, #dc2626);
  line-height: 1.45;
}

.pending-action {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--color-primary);
  font-weight: 600;
  padding: 8rpx 16rpx;
}

.resubmit-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  background: #eff6ff;
  border-radius: var(--radius-md, 12rpx);
  font-size: 24rpx;
  color: var(--color-primary);
}

.resubmit-cancel {
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}
