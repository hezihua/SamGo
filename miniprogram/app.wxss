page {
  background: #f8fafc;
  color: #0f172a;
  font-size: 28rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.btn-primary {
  background: #0060a9;
  color: #fff;
  border-radius: 12rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.muted {
  color: #64748b;
  font-size: 24rpx;
}
