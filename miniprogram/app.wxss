/* SamGo 设计规范：社区拼单 / 接龙风格 */
page {
  --color-primary: #0060a9;
  --color-primary-dark: #004a85;
  --color-accent: #ff6b00;
  --color-success: #07c160;
  --color-bg: #f5f6f8;
  --color-card: #ffffff;
  --color-text: #1a1a1a;
  --color-text-secondary: #666666;
  --color-text-muted: #999999;
  --color-border: #eeeeee;
  --color-danger: #ee0a24;
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 24rpx;
  --shadow-card: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);

  background: var(--color-bg);
  color: var(--color-text);
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue",
    sans-serif;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-head-bar {
  width: 8rpx;
  height: 32rpx;
  background: var(--color-primary);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.section-head-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.section-head-sub {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

button.btn-primary,
view.btn-primary,
.btn-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  background: linear-gradient(135deg, #0077c8 0%, var(--color-primary) 100%);
  color: #fff;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  line-height: 1;
}

view.btn-primary:active {
  opacity: 0.88;
}

view.btn-primary.is-disabled {
  opacity: 0.55;
  pointer-events: none;
}

button.btn-primary::after,
.btn-primary::after {
  border: none;
}

.btn-primary[disabled] {
  opacity: 0.55;
  background: #94a3b8;
}

.btn-wechat {
  background: var(--color-success);
  color: #fff;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
}

.btn-wechat::after {
  border: none;
}

.btn-ghost {
  background: #fff;
  color: var(--color-text-secondary);
  border: 1rpx solid var(--color-border);
  border-radius: 999rpx;
  font-size: 26rpx;
}

.btn-ghost::after {
  border: none;
}

.btn-outline {
  background: #fff;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: 999rpx;
  font-size: 26rpx;
}

.btn-outline::after {
  border: none;
}

.btn-danger-soft {
  background: #fff5f5;
  color: var(--color-danger);
  border: none;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.btn-danger-soft::after {
  border: none;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-open {
  background: #e8f4fd;
  color: var(--color-primary);
}

.tag-closed {
  background: #f0f0f0;
  color: var(--color-text-muted);
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text);
}

.muted {
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  box-sizing: border-box;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

view.bottom-bar-btn,
button.bottom-bar-btn,
.bottom-bar-btn {
  width: 100%;
  height: 92rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.btn-label {
  display: block;
  width: 100%;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  line-height: 92rpx;
}
