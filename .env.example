# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# 部署后的站点地址（复制接龙链接时用，如 https://xxx.vercel.app）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase 服务端（仅 API 使用，切勿暴露到小程序或前端）
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 微信小程序（公众平台 → 开发管理 → 开发设置）
WECHAT_MINI_APP_ID=your_mini_program_appid
WECHAT_MINI_APP_SECRET=your_mini_program_secret

# 微信账号密码派生密钥（随机长字符串，与 AppSecret 分开保存）
WECHAT_AUTH_SECRET=generate_a_long_random_string
