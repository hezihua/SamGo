# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Next API 根地址（小程序 config.js 的 apiBase；本地 dev 默认如下）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase 服务端（仅 API 使用，切勿暴露到小程序或前端）
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# 可选：Database URI，用于 pnpm db:apply:004 本地执行迁移（勿提交、勿暴露）
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-xxx.pooler.supabase.com:6543/postgres

# 微信小程序（公众平台 → 开发管理 → 开发设置）
WECHAT_MINI_APP_ID=your_mini_program_appid
WECHAT_MINI_APP_SECRET=your_mini_program_secret

# 拼单小程序码（getwxacodeunlimit）：develop/trial/release；本地未发布可设 CHECK_PATH=false
# WECHAT_WXACODE_ENV_VERSION=release
# WECHAT_WXACODE_CHECK_PATH=false

# 可选：团长微信 openid（登录 is_leader；发起拼单不限团长）
WECHAT_LEADER_OPENID=your_leader_openid

# Web 商品库管理（/admin/products）登录密码，仅服务端
ADMIN_PASSWORD=choose_a_strong_password

# Vercel Cron：到期自动截止拼单（/api/cron/close-expired-orders，每 5 分钟）
CRON_SECRET=generate_a_long_random_string

# 阿里云 OSS（商品图片上传，/admin 弹框）
ALIYUN_OSS_REGION=oss-cn-hangzhou
ALIYUN_OSS_BUCKET=your-bucket-name
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
# 可选：自定义 CDN 域名，末尾不要 /
# ALIYUN_OSS_PUBLIC_BASE_URL=https://cdn.example.com

# 微信账号密码派生密钥（随机长字符串，与 AppSecret 分开保存）
WECHAT_AUTH_SECRET=generate_a_long_random_string
